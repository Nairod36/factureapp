# Configuration de l'API Node.js pour Facture USDC

# Port du serveur (optionnel, défaut: 3000)
PORT=3000

# Clé secrète pour les JWT
JWT_SECRET=votre_cle_secrete_jwt_changez_la_en_production

# Configuration Blockchain
RPC_URL=https://rpc.ankr.com/eth_sepolia
PRIVATE_KEY=votre_cle_privee_pour_deploiement_et_transactions
CONTRACT_ADDRESS=adresse_du_contrat_invoice_deploye

# Adresses des tokens USDC selon le réseau
USDC_ADDRESS_ETHEREUM=0xA0b86a33E6417d69e83e5B5F4E4B4b0e
USDC_ADDRESS_SEPOLIA=0x1c7D4B196Cb0C7B01d743Fbc6116a902379C7238
USDC_ADDRESS_POLYGON=0x2791Bca1f2de4661ED88A30C99A7a9449Aa84174

# Base de données
DB_PATH=./database/factureapp.db
